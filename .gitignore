# @file .gitignore
# --- Node & Monorepo ---
node_modules/
client/node_modules/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Environment files (keep example files only) ---
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example

# Do NOT commit production secrets
# (Không đưa .env.production lên git/cPanel từ repo)
.env.production

# --- Build outputs ---
build/
dist/
client/build/
client/dist/
public/build/
public/dist/

# --- Caches & coverage ---
.cache/
.webpack/
coverage/
.nyc_output/

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
